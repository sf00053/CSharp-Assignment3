<Window x:Class="Assignment3.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment3"
        mc:Ignorable="d"
        Title="EditWindow" Height="300" Width="450"
        WindowStartupLocation="CenterOwner">
    <Canvas>
        <Label Content="_First Name:" Target="{Binding ElementName=txtFirstName}"
               Canvas.Left="15" Canvas.Top="15"/>
        <TextBox x:Name="txtFirstName" TabIndex="0"
                 Canvas.Left="20" Canvas.Top="45" Width="150" Height="25"
                 VerticalContentAlignment="Center"/>

        <Label Content="_Last Name:" Target="{Binding ElementName=txtLastName}"
               Canvas.Left="200" Canvas.Top="15"/>
        <TextBox x:Name="txtLastName" TabIndex="1"
                 Canvas.Left="205" Canvas.Top="45" Width="150" Height="25"
                 VerticalContentAlignment="Center"/>

        <Label Content="_Age:" Target="{Binding ElementName=txtAge}"
               Canvas.Left="15" Canvas.Top="85"/>
        <TextBox x:Name="txtAge" TabIndex="2"
                 Canvas.Left="20" Canvas.Top="115" Width="150" Height="25"
                 VerticalContentAlignment="Center"/>

        <Button x:Name="btnOk" Content="O_K" TabIndex="3"
                IsDefault="True" Click="btnOk_Click"
                Width="80" Height="30" Padding="10,4"
                Canvas.Right="110" Canvas.Bottom="20"/>
        <Button x:Name="btnCancel" Content="Cancel" TabIndex="4"
                IsCancel="True"
                Width="80" Height="30" Padding="10,4"
                Canvas.Right="20" Canvas.Bottom="20"/>
    </Canvas>
</Window>
